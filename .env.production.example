# Copia como ".env" en el servidor de backend y rellena valores reales.
# No lo subas a git.

FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Credenciales del usuario de aplicación creado por deploy/mongodb/init/init-app-user.sh,
# apuntando a la IP privada/VPN del servidor de base de datos.
MONGO_URI=mongodb://gafetdigital_app:CAMBIA_ESTO@10.0.0.1:27017/GafetDigital?authSource=GafetDigital

# URL real del frontend en producción (para CORS) — nunca localhost.
FRONTEND_URL=https://identificame.chihuahua.gob.mx

# Debe coincidir EXACTAMENTE con INTERNAL_API_KEY del servidor de frontend.
# Genera uno nuevo — no reutilices el de desarrollo.
INTERNAL_API_KEY=CAMBIA_ESTO_openssl_rand_-base64_32

# IP privada/VPN de este servidor por la que lo alcanza el frontend
# (usada por docker-compose.prod.yml).
BACKEND_BIND_IP=10.0.0.2
